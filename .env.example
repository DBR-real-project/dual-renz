# DualGuard 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env      (Windows: copy .env.example .env)
#   .env를 열어 실제 키 값을 채운다.
#
# .env는 .gitignore에 있어 커밋되지 않는다. 이 파일(.env.example)은 키 이름만
# 담은 템플릿이라 커밋된다 — 실제 값은 절대 여기에 채우지 말 것.
#
# 아무 키도 없어도 서비스는 죽지 않는다: 콘텐츠 분석은 키워드+임베딩 기반
# 오프라인 분류기(classify_offline)로 조용히 폴백한다. 다만 폴백 품질은
# LLM보다 낮다(src/content_analysis/llm_classifier.py 모듈 docstring 참고).

# --- 콘텐츠 분석 LLM 백엔드 선택 ---
# auto(기본, 비워두면 적용) | anthropic | gemini | openai | ollama | local
# auto는 Claude 키가 있으면 Claude, 없으면 Gemini 순으로 고른다.
# openai/ollama/local은 auto 체인에 없다 — 반드시 이 값을 명시해야 쓰인다.
DUALGUARD_LLM_PROVIDER=

# --- Claude(Anthropic) 백엔드 ---
ANTHROPIC_API_KEY=

# --- Gemini 백엔드 ---
# google-genai SDK는 GOOGLE_API_KEY를 자동으로 읽지만, 팀 문서 관례상
# GEMINI_API_KEY로 적는다(코드가 둘 다 받는다). 하나만 채우면 된다.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# 무료 티어 RPM 제한(실측 5 RPM) 대응. 초 단위, 0이면 대기 없음.
GEMINI_MIN_INTERVAL_SEC=0

# --- OpenAI(GPT) 백엔드 ---
# Gemini 무료 티어가 불안정할 때 대체용으로 추가(2026-09-02).
OPENAI_API_KEY=
# 기본값 gpt-4o-mini. 바꾸려면 값을 채울 것.
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama(로컬 LLM) 백엔드 ---
# 실서비스용이 아니라 프롬프트 구조를 로컬에서 공짜로 검증하는 용도.
# 키 불필요, 로컬 서버(기본 http://localhost:11434)만 떠 있으면 된다.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT_SEC=120

# --- local(transformers 소형 모델) 백엔드 ---
# 키도 서버 설치도 없이 LLM 경로를 검수하는 용도. 이미 깔린 torch/transformers만 쓴다.
# 소형 모델이라 성능을 기대하면 안 된다 — 검수용이다.
# DUALGUARD_LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# DUALGUARD_LOCAL_LLM_MAX_TOKENS=160

# --- 얼굴 검출기 선택 (media_detection) ---
# auto(기본, YuNet 1순위 → Haar 폴백) | yunet | haar
# DUALGUARD_FACE_DETECTOR=auto

# --- Kaggle 데이터셋 다운로드 (scripts/download_kaggle_data.py, 개발용) ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=
