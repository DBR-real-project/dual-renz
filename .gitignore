# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 모델 가중치 / 체크포인트 (용량 큼, 저장소에 넣지 않음)
models/**
!models/.gitkeep
*.p
*.pth
*.pt
*.ckpt
*.onnx
*.h5

# 외부 레포 클론 (FaceForensics, AASIST)
external/

# 벡터 DB (data_seed/scam_cases.json 에서 재생성 가능)
data/chroma/

# 데이터 전체 제외. 모두 scripts/ 로 재생성/재다운로드 가능하고,
# 외부 저작물(FF++ 영상, ASVspoof 음성, 샘플 이미지)이라 재배포하면 안 된다.
#   data/ff_samples/       fetch_ff_samples.py
#   data/asvspoof_samples/ fetch_asvspoof_samples.py
#   data/demo_clips/       make_demo_clips.py
#   data/test_clips/       make_synthetic_test_clip.py
#   data/sanity/           docs/model_research.md "재현 방법" 참고
#   data/stt_bench/        compare_stt_models.py (TTS로 자동 생성)
data/*
!data/.gitkeep

# 로컬 설정
.claude/settings.local.json

# API 키 등 비밀값. dual-lens/ 프로토타입에서 키를 소스에 하드코딩했던 전례가
# 있어서(폐기 완료) 예방선을 그어둔다. 실제 키가 든 .env는 절대 커밋하지 않는다.
# .env.example은 키 이름만 있는 템플릿이라 예외적으로 커밋한다 — 팀원이
# 뭘 채워야 하는지 보는 참고용.
.env
.env.*
!.env.example
*.key

# OS
Thumbs.db
desktop.ini

.mcp.json
.claude/

# 발표 자료 원본 — 카톡 캡처(휴대폰 UI 포함)라 저장소에 둘 이유가 없다.
# 정리된 결과물은 docs/ 에 PDF로 들어가 있다.
ppt/
0902_OT자료*.pdf
